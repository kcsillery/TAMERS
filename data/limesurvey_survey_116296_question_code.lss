   <row>
    <id><![CDATA[42829]]></id>
    <aid><![CDATA[10617]]></aid>
    <answer><![CDATA[Olšové, březovéý nebo osikové lesy mimo říční aluvia <span data-toggle="popis" title="Olšový les, Italský olšový les, Boreální březový les, Jižní boreální březový les, Osikový les"><u>(typy lesů)</u> </span>]]></answer>
