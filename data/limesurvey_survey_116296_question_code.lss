    <question><![CDATA[<p>¿Usted sembraría o continuaría sembrando las siguientes especies coníferas en su bosque de referencia?</p>

<p>Por favor note que puede seleccionar razones de por qué si y por qué no. (Fuente de las imágenes: https://www.forestryimages.org, alamy.com).</p>
<script type="text/javascript" data-author="Tony Partner">

  $(document).on('ready pjax:scriptcomplete',function(){

    var thisQuestion = $('#question{QID}');

   if($('.inserted-select', thisQuestion).length == 0) {

      // Column-specific classes
      $('tr.subquestion-list', thisQuestion).each(function(i) {
        $('th, td', this).each(function(i) {
          $(this).addClass('column-'+i);
        });
      });

     // Insert selects into column 1
      $('.answer-item.column-1', thisQuestion).addClass('with-select').append('<select class="inserted-select form-control list-question-select">\
      <option value="" selected>Por favor seleccione una opción.</option>\
      <option value="option1">Si, en monocultivos</option>\
      <option value="option2">Si, en siembras/bosques mixtas</option>\
      <option value="option3">Si, pero esporádicamente</option>\
      <option value="option4">No</option>\
      <option value="option5">No aplica a mi bosque de referencia</option>\
      <option value="option6">No sé</option>\
      </select>');

      // Insert checkboxes into column 2
      $('.answer-item.column-2', thisQuestion).each(function(i) {
        var column = 2;
        var row = i+1;
        $(this).addClass('with-multi-opt').append('<ul class="list-unstyled inserted-list">\
            <li class="question-item checkbox-item inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box1" value="Estético">\
              <label for="'+row+'_'+column+'_box1" class="checkbox-label control-label">Estético</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box2" value="Aumenta la diversidad genética">\
              <label for="'+row+'_'+column+'_box2" class="checkbox-label control-label">Aumenta la diversidad genética</label>\
