    <question><![CDATA[Am observat următoarele evenimente crescând în pădurea mea de referință în ultimii ani <script type="text/javascript" data-author="Tony Partner">  
 
  $(document).on('ready pjax:scriptcomplete',function(){
 
    // Identify this question
    var qID = '{QID}';
    var thisQuestion = $('#question'+qID);
 
 
    /****** HEADER ROWS ******/
 
