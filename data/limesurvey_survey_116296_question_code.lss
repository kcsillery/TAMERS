     // Insert selects into column 1
      $('.answer-item.column-1', thisQuestion).addClass('with-select').append('<select class="inserted-select form-control list-question-select">\
      <option value="" selected>Veuillez choisir</option>\
      <option value="option1">Oui dans les peuplements purs</option>\
      <option value="option2">Oui dans les peuplements mixtes</option>\
      <option value="option3">Oui, mais sporadiquement</option>\
      <option value="option4">Non</option>\
      <option value="option5">Non applicable à ma forêt de référence</option>\
      <option value="option6">Je ne sais pas</option>\
      </select>');
      // Insert checkboxes into column 2
      $('.answer-item.column-2', thisQuestion).each(function(i) {
        var column = 2;
        var row = i+1;
