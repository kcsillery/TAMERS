              <label for="'+row+'_'+column+'_box4" class="checkbox-label control-label">Importing pests and pathogens</label>\
            </li>\
           <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box5" value="Risk to be affected by a disease">\
              <label for="'+row+'_'+column+'_box5" class="checkbox-label control-label">Risk to be affected by a disease</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box6" value="Outbreeding depression">\
              <label for="'+row+'_'+column+'_box6" class="checkbox-label control-label">Outbreeding depression</label>\
            </li>\
    <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box7" value="Frost susceptibility">\
