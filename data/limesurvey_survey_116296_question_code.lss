   </row>
   <row>
    <id><![CDATA[42830]]></id>
    <aid><![CDATA[10617]]></aid>
    <answer><![CDATA[Ikke-flodnær skov med el, birk eller asp <span data-toggle="tooltip" title="Elleskov, Italiensk elleskov, Boreal birkeskov, Sydboreal birkeskov, Aspeskov"><u>(Skovtyper)</u> </span>]]></answer>
    <language><![CDATA[da]]></language>
   </row>
   <row>
    <id><![CDATA[42831]]></id>
    <aid><![CDATA[10617]]></aid>
    <answer><![CDATA[Niet riviergebonden elzen-, berken- of espenbos <span data-toggle="tooltip" title="Elzenbos, Italiaans elzenbos, Boreaal berkenbos, Zuidelijk boreaal berkenbos, Aspenbos"><u>(bostypen)</u> </span>]]></answer>
