              <label for="'+row+'_'+column+'_box5" class="checkbox-label control-label">Hodnota biologické rozmanitosti</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box6" value="Druh přizpůsobený suchu">\
              <label for="'+row+'_'+column+'_box6" class="checkbox-label control-label">Druh přizpůsobený suchu</label>\
            </li>\
