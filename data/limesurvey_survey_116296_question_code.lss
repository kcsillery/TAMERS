  #question{QID} col:nth-child(1) { width: 25% !important}
  #question{QID} col:nth-child(2) { width: 15% !important}
  #question{QID} col:nth-child(3) { width: 30% !important}
  #question{QID} col:nth-child(4) { width: 30% !important}
</style>
]]></question>
