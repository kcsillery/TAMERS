   <row>
    <id><![CDATA[84763]]></id>
    <qid><![CDATA[29581]]></qid>
    <question><![CDATA[Please confirm that you agree with the <a href="/limesurvey/upload/surveys/116296/images/EN_consent-form_edits_TAMERS_final_2.pdf" target="_blank">Informed consent form</a> by clicking on "Yes, I agree" below. If you do not agree or if you have questions, you can leave this form and contact us at tamers.survey@wsl.ch]]></question>
