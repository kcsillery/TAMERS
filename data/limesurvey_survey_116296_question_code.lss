            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box2" value="Increase genetic diversity">\
              <label for="'+row+'_'+column+'_box2" class="checkbox-label control-label">Increase genetic diversity</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box3" value="Maintains forest composition">\
              <label for="'+row+'_'+column+'_box3" class="checkbox-label control-label">Maintains forest composition</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box4" value="Economic value">\
              <label for="'+row+'_'+column+'_box4" class="checkbox-label control-label">Economic value</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box5" value="Biodiversity value">\
              <label for="'+row+'_'+column+'_box5" class="checkbox-label control-label">Biodiversity value</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box6" value="Species adapted to drought">\
              <label for="'+row+'_'+column+'_box6" class="checkbox-label control-label">Species adapted to drought</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box7" value="Species good for soil protection">\
              <label for="'+row+'_'+column+'_box7" class="checkbox-label control-label">Species good for soil protection</label>\
           </li>\
           <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box8" value="Replacement for Spruce (Picea abies)">\
              <label for="'+row+'_'+column+'_box8" class="checkbox-label control-label">Replacement for Spruce (Picea abies)</label>\
            </li>\
          </ul>');
      });

         // Insert checkboxes into column 3
      $('.answer-item.column-3', thisQuestion).each(function(i) {
        var column = 3;
        var row = i+1;
        $(this).addClass('with-multi-opt').append('<ul class="list-unstyled inserted-list">\
            <li class="question-item checkbox-item inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box1" value="Ecosystem collapse">\
              <label for="'+row+'_'+column+'_box1" class="checkbox-label control-label">Ecosystem collapse</label>\
            </li>\
