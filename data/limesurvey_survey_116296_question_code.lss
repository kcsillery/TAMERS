      <option value="option2">Ja in Mischbeständen</option>\
      <option value="option3">Ja, aber sporadisch</option>\
      <option value="option4">Nein</option>\
      <option value="option5">Nicht zutreffend für meinen Referenzwald</option>\
      <option value="option6">Ich weiß es nicht</option>\
      </select>');

      // Insert checkboxes into column 2
