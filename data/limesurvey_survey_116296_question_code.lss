              <label for="'+row+'_'+column+'_box1" class="checkbox-label control-label">Estetický</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box2" value="‚Zvýšení genetické rozmanitosti‘">\
              <label for="'+row+'_'+column+'_box2" class="checkbox-label control-label">‚Zvýšení genetické rozmanitosti‘</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box3" value="Zachování složení lesa">\
              <label for="'+row+'_'+column+'_box3" class="checkbox-label control-label">Zachování složení lesa</label>\
            </li>\
            <li class="question-item checkbox-item  inserted-item">\
              <input type="checkbox" id="'+row+'_'+column+'_box4" value="Ekonomická hodnota">\
              <label for="'+row+'_'+column+'_box4" class="checkbox-label control-label">Ekonomická hodnota</label>\
