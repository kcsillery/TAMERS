   <row>
    <id><![CDATA[42832]]></id>
    <aid><![CDATA[10617]]></aid>
    <answer><![CDATA[Ei-jokivarret leppä-, koivu- tai haapametsä <span data-toggle="tooltip" title="Leppämetsä, italialainen leppä, boreaalinen koivumetsä, eteläinen boreaalinen koivumetsä, haapametsä"><u>(metsätyypit)</u> </span>]]></answer>
