   <row>
    <id><![CDATA[29446]]></id>
    <aid><![CDATA[10035]]></aid>
    <answer><![CDATA[Hemiboreaalinen metsä ja nemoraalinen havu- ja sekalehtipuumetsä <span data-toggle="tooltip" title="Hemiboreaalinen metsä, nemoraalinen mäntymetsä, kuusimetsä, mustamäntymetsä, sekametsä, jossa on mänty-koivu tai tammimetsä"><u>(metsätyypit)</u> </span>]]></answer>
